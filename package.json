{
  "name": "marble-speed-run",
  "version": "1.0.0",
  "description": "Marble Rush – a vanilla JS canvas speed-run game. Outrun the fog. Survive forever.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
