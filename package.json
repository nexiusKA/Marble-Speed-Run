{
  "name": "marble-speed-run",
  "version": "1.1.2",
  "description": "Marble Rush – a vanilla JS canvas speed-run game. Outrun the fog. Survive forever.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "test:regression": "node scripts/regression-test.js",
    "cap:sync:android": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "test:e2e": "node tests/e2e.test.js",
    "test": "npm run test:regression && npm run build && npm run test:e2e && npm run test:perf",
    "test:syntax": "node scripts/check-syntax.js",
    "test:perf": "node tests/perf.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  }
}
